# Backend environment example — copy to .env and fill real values locally.
# ENV: dev | prod
ENV=dev
# SQLAlchemy async URL (asyncpg driver, added in todo 2).
# NOTE: a literal '@' in the password must be percent-encoded as %40.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/mir_dev
