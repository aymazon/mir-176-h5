# mir-176-h5 生产环境变量模板
#
# 用法（INSTALL.md §2）：复制到 dell1 的 /opt/mir-176-h5/shared/backend.env 后填真实值。
#   chmod 600，owner aymazon:aymazon（systemd EnvironmentFile 读取，User=aymazon 可读即可）。
# 红线：本文件只放占位符，真实口令/密钥一律不进 git 仓库。

# 运行环境：dev | prod。prod 语义见 backend/app/core/config.py Settings.ENV。
ENV=prod

# 生产数据库 DSN（SQLAlchemy async，asyncpg 驱动）。
#   mir_app：task 33 建的专用账号（非超管、无 createdb），仅拥有 mir_prod。
#   REPLACE_AT_DEPLOY → task 33 生成的 48hex 口令（存 .omo/evidence/task-33 日志，gitignored）。
#   hex 口令无需 URL percent-encode；若口令含 '@' 必须编码为 %40。
#   127.0.0.1：backend 与 PG（docker postgres:18, 0.0.0.0:5432）同机。
DATABASE_URL=postgresql+asyncpg://mir_app:REPLACE_AT_DEPLOY@127.0.0.1:5432/mir_prod

# 会话签名密钥（预留占位）：当前 backend 未消费此变量——auth 用内存 session +
# secrets 模块（backend/app/api/auth.py），pydantic-settings extra="ignore" 会忽略多余键。
# 为将来签名 cookie / JWT 预留；部署时生成：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# uvicorn 监听地址：systemd unit ExecStart 以 ${BIND_HOST}/${BIND_PORT} 引用这两个值。
# 硬约束：127.0.0.1（仅本机 nginx 反代可达，不暴露 LAN）；
#         8000 必须与 deploy/nginx.conf 的 proxy_pass http://127.0.0.1:8000 一致。
BIND_HOST=127.0.0.1
BIND_PORT=8000

# ---- 可选：SSE 通道参数覆盖（默认值见 backend/app/core/config.py，一般无需改）----
# SSE_PING_INTERVAL=15.0            # SSE 心跳间隔（秒）；< nginx proxy_read_timeout 3600s
# SSE_GRACE_PERIOD_SECONDS=60.0     # SSE 断开后会话存活宽限
# SSE_BUFFER_SIZE=1200              # 每会话事件 ring buffer 容量（重放窗口）
