# mir-176-h5 backend — FastAPI/uvicorn 生产单元（dell1）
#
# 安装：复制为 /etc/systemd/system/mir-backend.service（见 INSTALL.md §5）。
#
# 架构红线（不可违反）：
#   - --workers 1 硬编码：会话/地图/SSE 状态全在单进程内存，多 worker 会撕裂状态。
#   - 无 Redis、无 WebSocket。
#
# 解释器：.venv 由 `uv sync --frozen` 在 release 内创建，其 python 是 uv-managed
#         CPython 3.12.14（dell1 系统 python3=3.11 不满足 requires-python>=3.12）。
#         ExecStart 直执行 venv 内 uvicorn（不经 `uv run` 包装）：进程树干净、
#         SIGTERM 直达 uvicorn、启动不依赖 PATH/网络。

[Unit]
Description=mir-176-h5 backend (FastAPI/uvicorn, single worker)
# PG 在 dell1 本机 docker 容器（postgres:18, restart=always）→ 排在 docker 之后；
# 容器启动竞态由 Restart=on-failure + SQLAlchemy pool_pre_ping 吸收。
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=aymazon
Group=aymazon
WorkingDirectory=/opt/mir-176-h5/current/backend
# 环境：ENV=prod / DATABASE_URL / BIND_HOST / BIND_PORT（模板见 deploy/env.template）
EnvironmentFile=/opt/mir-176-h5/shared/backend.env
# systemd 对 ${VAR} 做环境替换，值来自上面的 EnvironmentFile；
# 拓扑硬约束 = 127.0.0.1:8000，与 deploy/nginx.conf 的 proxy_pass 对齐。
ExecStart=/opt/mir-176-h5/current/backend/.venv/bin/uvicorn app.main:app --host ${BIND_HOST} --port ${BIND_PORT} --workers 1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mir-backend
# 加固基线（/opt 保持可写：release 内 __pycache__ 需要；仅 /usr /boot /efi 只读）
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
